# ============================================================
# Derby Stat Tracker — Web App Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file — it is git-ignored.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Find these in your Supabase project:
#   Settings → API → Project URL / Project API Keys (anon / public)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Scoreboard API ───────────────────────────────────────────
# URL of the running derby-scoreboard-api service.
# In a typical local setup this is on the same machine as CRG ScoreBoard.
# Users can also override this value in the Live Scoreboard settings UI.

VITE_SCOREBOARD_API_URL=http://localhost:5001

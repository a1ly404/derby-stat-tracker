# Scoreboard API (derby-scoreboard-api service)
SCOREBOARD_API_URL=http://localhost:5001

# Supabase (use the service role key — NOT the anon key — for server-side writes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Polling interval in milliseconds (default: 1000, minimum: 200)
POLL_INTERVAL_MS=1000

# How long to wait before declaring a jam complete after it ends (ms)
JAM_END_DEBOUNCE_MS=2000

# Optional: log level (debug | info | warn | error)
LOG_LEVEL=info

# Optional: bout ID to associate this live session with (UUID from the bouts table)
# Leave unset if you don't want to link the live game to a specific bout
BOUT_ID=
